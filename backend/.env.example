# Copy this file to backend/.env and fill in real values for local
# development. backend/.env is gitignored and never deployed — on Render,
# these same keys are set as environment variables in the service's
# dashboard (or via the root render.yaml blueprint) with production
# values instead, so local and production configs never collide.

# --- Database ---------------------------------------------------------
# Each shared/*_core module owns its own DATABASE_URL (see CLAUDE.md —
# separate engines by design, even though today they all point at the
# same Postgres database). Locally this is one local Postgres instance;
# on Render, all six should be set to the same Render Postgres connection
# string (its "Internal Database URL" if the web service and database are
# in the same region, to avoid needing sslmode=require).
AUTH_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
SUBSCRIPTIONS_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
INTEGRATIONS_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
MIGRATIONS_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
BUSINESSES_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
TENANTS_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard
CONTENT_DATABASE_URL=postgresql://saas_user:password@localhost:5432/saas_dashboard

# --- shared/integrations_core and shared/tenants_core: token encryption -
# Encrypts every stored OAuth secret at rest. Read independently by both
# modules (same unprefixed-shared-var precedent as GOOGLE_CLIENT_ID
# below). Generate a DIFFERENT key for each environment (local vs.
# Render) — no reason to share one, and it contains the blast radius if
# either leaks:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: if tokens already exist in this database from before this
# was added, run `python -m shared.integrations_core.encrypt_existing_tokens`
# and `python -m shared.tenants_core.encrypt_existing_tokens` with this
# key set BEFORE running code that expects it — see crypto.py in each
# module for why the order matters.
TOKEN_ENCRYPTION_KEY=

# --- shared/auth_core ---------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
AUTH_SECRET_KEY=
# Local dev runs over plain HTTP; the browser would silently drop a
# `secure` cookie here. Leave unset (true is the default) on Render,
# which serves over HTTPS — only set this to false for local HTTP dev.
AUTH_COOKIE_SECURE=false

# --- shared/integrations_core (personal Google/Dropbox/Microsoft) ------
# Fill in from https://console.cloud.google.com/ (APIs & Services >
# Credentials > OAuth client ID > Web application). Register BOTH this
# redirect URI (localhost, for local dev) AND the Render one as separate
# "Authorized redirect URIs" on the same OAuth client — no need for two
# separate client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/oauth/callback

# Fill in from https://www.dropbox.com/developers/apps. Add both the
# localhost and Render redirect URIs under the app's Redirect URIs.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8000/dropbox/oauth/callback

# One Azure AD app registration covers both the personal OneDrive
# connector here and the Microsoft 365 admin/tenant connector below.
# Register as "Accounts in any organizational directory and personal
# Microsoft accounts", and add all four redirect URIs below (local +
# Render, personal + admin) as "Web" platform redirect URIs on that one
# app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/connect/microsoft/callback
MICROSOFT_TENANT=common

# Optional — only needed for the "email me this report" buttons.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- shared/tenants_core (organization-wide admin metrics) -------------
# Reuses the GOOGLE_*/MICROSOFT_*/DROPBOX_* app credentials above — just
# needs its own redirect URIs added to those same OAuth apps/consoles
# (Google/Dropbox/Microsoft all support multiple redirect URIs per app).
GOOGLE_ADMIN_REDIRECT_URI=http://localhost:8000/tenants/google-workspace/callback
MICROSOFT_ADMIN_REDIRECT_URI=http://localhost:8000/tenants/microsoft365/callback
DROPBOX_BUSINESS_REDIRECT_URI=http://localhost:8000/tenants/dropbox-business/callback
